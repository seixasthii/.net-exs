@model Exemplo01B.Models.Produto
@{
    ViewData["Title"] = "Editar Produto";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Edit" method="post">
    <div>
        <label>Nome: </label>
        <input asp-for="Nome" />
    </div>
    <div>
        <label>Preço: </label>
        <input asp-for="Preco" />
    </div>
    <div>
        <label>Quantidade: </label>
        <input asp-for="Quantidade" />
    </div>
    <button type="submit">Salvar</button>
</form>

<div>
    
</div>