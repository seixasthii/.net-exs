@model List<Exemplo01B.Models.Produto>

@if(TempData["Mensagem"] != null){
    <script>
        alert('@TempData["Mensagem"]');
    </script>
}

@{
    ViewData["Title"] = "Lista de Produtos";
}

<h2>Produtos</h2>

<table class="table">
    <tr>
        <th>ID</th>
        <th>Nome</th>
        <th>Preço</th>
        <th>Quantidade</th>
        <th>Editar</th>
        <th>Delete</th>
    </tr>
@foreach (var item in Model)
{
    <tr>
        <td>@item.Id</td>
        <td>@item.Nome</td>
        <td>@item.Preco</td>
        <td>@item.Quantidade</td>
        <td><a href="/Produtos/Edit/@item.Id">Editar</a></td>
        <td><a href="/Produtos/Delete/@item.Id">Deletar</a></td>
    </tr>
}
</table>

<a href="/Produtos/Criar">Adicionar Produto</a>